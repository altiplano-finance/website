---
import Layout from '../components/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { url } from '../utils';

const featured = [
  {
    title: 'Raise Capital',
    description:
      'Walk into a raise prepared, with the financials, narrative, and strategy investors expect.',
  },
  {
    title: 'Steer the Business',
    description:
      'Build the strategic finance function, with a fractional CFO before you need one full-time.',
  },
  {
    title: 'Stay Ahead',
    description:
      'See your market, your competitors, the capital around you, and where you stand against them.',
  },
];
---

<Layout path="/">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-media">
      <img
        src={url('/images/mountain_wide_p.png')}
        alt="Layered Andean mountain ranges at altitude"
        width="1774"
        height="887"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-scrim" aria-hidden="true"></div>
    </div>

    <div class="container">
      <div class="hero-inner stack">
        <span class="eyebrow">Strategic Finance Advisory</span>
        <h1 class="hero-title">
          Strategic Finance for Energy, Climate &amp; Deep Tech Startups
        </h1>
        <p class="hero-sub">
          Fundraising, forecasting, and capital strategy for early- to
          growth-stage energy, climate, and deep tech startups.
        </p>
        <div class="hero-actions">
          <a class="btn" href={url('/contact')}>
            Contact Us <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href={url('/services')}>View Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- POSITIONING -->
  <section class="section intro">
    <div class="container intro-grid">
      <div class="stack reveal">
        <span class="eyebrow">Built to operate</span>
        <h2>Run your finances with the rigor investors expect.</h2>
      </div>
      <div class="intro-body stack reveal">
        <p class="lede">
          Well-run finances are a lasting advantage and the foundation of a
          strong raise. We help you build them early with reliable forecasts,
          clear reporting, and the models and narrative investors look for, as
          your fractional CFO and fundraising partner.
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURED SERVICES -->
  <section class="section section--tinted services-preview">
    <div class="container stack">
      <div class="section-head stack reveal">
        <span class="eyebrow">What we do</span>
        <h2>Capabilities built for energy, climate, and deep tech founders</h2>
        <p class="lede">
          A focused advisory partnership, from raising your next round to steering
          the business to reading the market ahead.
        </p>
      </div>
      <div class="services-grid">
        {featured.map((s) => <ServiceCard title={s.title} description={s.description} />)}
      </div>
      <div class="services-cta reveal">
        <a class="btn btn--ghost" href={url('/services')}>
          Explore all services <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="cta-band">
    <div class="container cta-inner reveal">
      <div class="stack">
        <span class="eyebrow eyebrow--light">Start the conversation</span>
        <h2 class="cta-title">
          Raising capital, or building the model behind it?
        </h2>
      </div>
      <div class="cta-actions">
        <a class="btn btn--on-dark" href={url('/contact')}>
          Contact Us <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn--ghost-light" href={url('/services')}>View Services</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    isolation: isolate;
    /* No min-height: the photo band hugs its content, so the top and bottom
       padding below are the only spacing around the text. */
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }

  .hero-media,
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media img {
    object-fit: cover;
    object-position: center bottom;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(0, 20, 33, 0.75) 0%,
      rgba(0, 20, 33, 0.45) 42%,
      rgba(0, 20, 33, 0.2) 100%
    );
  }

  /* The photo band follows the site-wide --space rhythm (.stack): top bar to
     eyebrow, between each block, and below the buttons. */
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space);
    max-width: 920px;
  }

  .hero .eyebrow {
    color: var(--andes-rose);
  }

  .hero-title {
    color: var(--sand);
    max-width: 16ch;
  }

  .hero-sub {
    color: rgba(245, 237, 230, 0.86);
    font-size: calc(clamp(1.075rem, 1rem + 0.6vw, 1.35rem) * var(--text-scale));
    line-height: 1.6;
    max-width: 54ch;
    margin-block: var(--trim-lede);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero .btn--ghost {
    --btn-fg: var(--sand);
    --btn-bd: rgba(245, 237, 230, 0.4);
  }
  .hero .btn--ghost:hover {
    --btn-bg: rgba(245, 237, 230, 0.12);
    --btn-bd: var(--sand);
  }

  /* --- Intro --- */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space) clamp(2rem, 6vw, 5rem);
    /* Eyebrow + headline stay top-aligned on the left; the description is
       vertically centered in the section. */
    align-items: start;
  }

  .intro-body {
    align-self: center;
  }

  .intro-body .lede {
    font-size: calc(clamp(1.15rem, 1.05rem + 0.7vw, 1.45rem) * var(--text-scale));
  }

  /* --- Services preview --- */
  .services-preview {
    background: var(--sand-deep);
  }

  .section-head {
    max-width: 60ch;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space);
  }

  /* --- CTA band --- */
  .cta-band {
    background: var(--navy);
    color: var(--sand);
    padding-block: var(--space);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space);
    flex-wrap: wrap;
  }

  .eyebrow--light {
    color: var(--andes-rose);
  }

  .cta-title {
    color: var(--sand);
    max-width: 20ch;
  }

  .cta-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .btn--ghost-light {
    background: transparent;
    color: var(--sand);
    border: 1px solid rgba(245, 237, 230, 0.4);
  }
  .btn--ghost-light:hover {
    background: rgba(245, 237, 230, 0.12);
    border-color: var(--sand);
    color: var(--sand);
    transform: translateY(-2px);
  }

  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .hero-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
